<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- DayNight so the WebView reports the phone's light/dark setting to the page's CSS. -->
    <style name="Theme.Passbook" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/page</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
