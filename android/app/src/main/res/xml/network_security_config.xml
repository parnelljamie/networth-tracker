<?xml version="1.0" encoding="utf-8"?>
<!-- The WebView talks to the app's own server on 127.0.0.1 over plain HTTP; everything else stays
     HTTPS-only. (Syncing with the PC is done from Python, which this config doesn't govern.) -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
